# Supabase Configuration
# Replace these with your actual Supabase project URL and anon public key
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Storage Bucket Name (Default is 'gallery-media')
VITE_SUPABASE_BUCKET=gallery-media

# Admin Passcode for uploading and managing media in the Gallery
# Default passcode is 1234. Change this to any secret PIN you prefer.
VITE_ADMIN_PIN=1234
